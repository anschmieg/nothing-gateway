new file mode 100644
index 0000000000000000000000000000000000000000..c20a5fdea7742c4a72c9f3214f21305692c723a1
--- /dev/null
+++ b/internal/registry/catalog_fallback_profiles.go
@@ -0,0 +1,71 @@
+package registry
+
+import (
+	"context"
+	"errors"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/catalogfallback"
+	"regexp"
+)
+
+type ModelProfile struct {
+	PreferredModel string               `yaml:"preferred-model,omitempty" json:"preferred-model,omitempty"`
+	Task           catalogfallback.Task `yaml:"task" json:"task"`
+	MaxModels      int                  `yaml:"max-models,omitempty" json:"max-models,omitempty"`
+	CostPolicy     string               `yaml:"cost-policy,omitempty" json:"cost-policy,omitempty"`
+}
+
+var profileName = regexp.MustCompile(`^[a-z][a-z0-9-]{0,31}$`)
+
+func ValidateModelProfiles(profiles map[string]ModelProfile) error {
+	if len(profiles) > 32 {
+		return errors.New("too many model profiles")
+	}
+	for name, p := range profiles {
+		if !profileName.MatchString(name) || name == "admin" || name == "v1" || name == "dashboard" {
+			return errors.New("invalid/reserved model profile name")
+		}
+		if p.Task != catalogfallback.Coding && p.Task != catalogfallback.Agent && p.Task != catalogfallback.Reasoning && p.Task != catalogfallback.Structured && p.Task != catalogfallback.LongContext && p.Task != catalogfallback.General {
+			return errors.New("unsupported model profile task")
+		}
+		if p.MaxModels < 0 || p.MaxModels > 50 {
+			return errors.New("profile model limit out of range")
+		}
+		if p.CostPolicy != "" && p.CostPolicy != "free-only" && p.CostPolicy != "session" {
+			return errors.New("profile cost policy must be session or free-only")
+		}
+	}
+	return nil
+}
+func (p CanonicalRoutingConfig) Profile(name string) (ModelProfile, bool) {
+	if len(p.Profiles) == 0 {
+		if name == "coding" || name == "chat" {
+			task := catalogfallback.Coding
+			if name == "chat" {
+				task = catalogfallback.General
+			}
+			return ModelProfile{Task: task, MaxModels: 12, CostPolicy: "session"}, true
+		}
+		return ModelProfile{}, false
+	}
+	v, ok := p.Profiles[name]
+	if !ok {
+		return ModelProfile{}, false
+	}
+	if v.MaxModels == 0 {
+		v.MaxModels = 12
+	}
+	if v.CostPolicy == "" {
+		v.CostPolicy = "session"
+	}
+	return v, true
+}
+
+type profileContextKey struct{}
+
+func WithModelProfile(ctx context.Context, name string) context.Context {
+	return context.WithValue(ctx, profileContextKey{}, name)
+}
+func ModelProfileFromContext(ctx context.Context) string {
+	v, _ := ctx.Value(profileContextKey{}).(string)
+	return v
+}
diff --git a/internal/registry/catalog_fallback_registry.go b/internal/registry/catalog_fallback_registry.go
new file mode 100644
index 0000000000000000000000000000000000000000..93a11b1bd5a5e748bd301ddd10fc1e20155cc527
--- /dev/null
+++ b/internal/registry/catalog_fallback_registry.go
@@ -0,0 +1,166 @@
+package registry
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	log "github.com/sirupsen/logrus"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/catalogfallback"
+)
+
+// Reuse the host catalog-updater lifecycle/generation fencing. This source is
+// advisory evidence only: it does not publish routes, auths, costs or aliases.
+var fallbackLiveCache = catalogfallback.NewLiveCache(nil)
+var fallbackEvidenceUpdater = newFallbackEvidenceUpdater()
+
+type fallbackEvidenceSource struct {
+	Source string
+	Cache  string
+}
+
+func configureFallbackEvidence(ctx context.Context, source, cache string) {
+	if source == "disabled" {
+		fallbackEvidenceUpdater.configure(ctx, source)
+		return
+	}
+	descriptor, _ := json.Marshal(fallbackEvidenceSource{source, cache})
+	// Disk bootstrap makes last-good evidence available before the first network
+	// attempt completes. Age still comes from its actual origin validation time.
+	if source == catalogfallback.LiveCatalogURL || source == catalogfallback.GitCatalogURL {
+		if data, ok := fallbackLiveCache.Cached(source, cache, time.Now()); ok {
+			if err := catalogfallback.DefaultStore.PublishFrom(source, data, time.Now()); err != nil {
+				log.Warn("fallback evidence disk cache rejected")
+			}
+		}
+	}
+	fallbackEvidenceUpdater.configure(ctx, string(descriptor))
+}
+
+func newFallbackEvidenceUpdater() *catalogUpdater {
+	u := &catalogUpdater{fetch: func(ctx context.Context, descriptor string) ([]byte, error) {
+		var d fallbackEvidenceSource
+		if json.Unmarshal([]byte(descriptor), &d) != nil {
+			return nil, errors.New("invalid evidence refresh configuration")
+		}
+		if d.Source == catalogfallback.LiveCatalogURL || d.Source == catalogfallback.GitCatalogURL {
+			data, fresh, err := fallbackLiveCache.Refresh(ctx, d.Source, d.Cache, time.Now())
+			if err != nil {
+				log.Warn("fallback evidence refresh/cache unavailable")
+			}
+			if !fresh && len(data) > 0 {
+				log.Warn("fallback evidence origin unavailable; retained last-good age")
+			}
+			if len(data) > 0 {
+				return data, nil
+			}
+			return nil, err
+		}
+		return readFallbackEvidence(ctx, d.Source)
+	}}
+	u.publish = func(data []byte) ([]string, error) {
+		var d fallbackEvidenceSource
+		if json.Unmarshal([]byte(u.source), &d) != nil {
+			return nil, errors.New("invalid evidence publication configuration")
+		}
+		err := catalogfallback.DefaultStore.PublishFrom(d.Source, data, time.Now())
+		if err == nil {
+			log.Info("fallback evidence metadata loaded")
+		}
+		return nil, err
+	}
+	return u
+}
+func readFallbackEvidence(ctx context.Context, source string) ([]byte, error) {
+	var reader io.ReadCloser
+	if filepath.IsAbs(source) {
+		f, err := os.Open(source)
+		if err != nil {
+			return nil, errors.New("fallback evidence file unavailable")
+		}
+		reader = f
+	} else {
+		u, err := url.Parse(source)
+		if err != nil || u.Scheme != "https" || u.User != nil || u.Host != "models.dev" || u.Path != "/catalog.json" || u.RawQuery != "" || u.Fragment != "" {
+			return nil, errors.New("fallback evidence URL must be https://models.dev/catalog.json")
+		}
+		req, err := http.NewRequestWithContext(ctx, http.MethodGet, source, nil)
+		if err != nil {
+			return nil, err
+		}
+		client := &http.Client{Timeout: 15 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+		res, err := client.Do(req)
+		if err != nil {
+			return nil, errors.New("fallback evidence fetch failed")
+		}
+		if res.StatusCode != 200 {
+			res.Body.Close()
+			return nil, errors.New("fallback evidence HTTP status refused")
+		}
+		reader = res.Body
+	}
+	defer reader.Close()
+	b, err := io.ReadAll(io.LimitReader(reader, catalogfallback.MaxCatalogBytes+1))
+	if err != nil || len(b) > catalogfallback.MaxCatalogBytes {
+		return nil, errors.New("fallback evidence size/read failure")
+	}
+	if filepath.IsAbs(source) {
+		var envelope struct {
+			Evidence struct {
+				RetrievedAt string `json:"retrieved_at"`
+			} `json:"_evidence"`
+		}
+		if json.Unmarshal(b, &envelope) != nil || envelope.Evidence.RetrievedAt == "" {
+			return nil, errors.New("local evidence needs retrieval timestamp; use the snapshot importer")
+		}
+	}
+	return b, nil
+}
+
+// Expiry-aware registry check, paired with the native auth-manager predicate.
+// No state is removed, resumed, refreshed, or probed by this read.
+func (r *ModelRegistry) CanonicalFallbackRegistryAvailable(client, route string, now time.Time) bool {
+	r.mutex.RLock()
+	defer r.mutex.RUnlock()
+	return r.canonicalFallbackRegistryAvailableLocked(client, route, now)
+}
+
+func (r *ModelRegistry) canonicalFallbackRegistryAvailableLocked(client, route string, now time.Time) bool {
+	info := r.clientModelInfos[client][route]
+	if info == nil {
+		return false
+	}
+	for _, key := range []string{route, info.CanonicalID, info.CanonicalSourceID, info.MetadataModelID} {
+		registration := r.models[key]
+		if registration == nil {
+			continue
+		}
+		if q := registration.QuotaExceededClients[client]; q != nil && now.Before(q.Add(modelQuotaExceededWindow)) {
+			return false
+		}
+		if reason, ok := registration.SuspendedClients[client]; ok && !isQuotaSuspension(reason) {
+			return false
+		}
+	}
+	return true
+}
+
+func ValidateFallbackEvidenceSource(source string) error {
+	if source == "" || source == "disabled" || filepath.IsAbs(source) {
+		return nil
+	}
+	if source == catalogfallback.GitCatalogURL {
+		return nil
+	}
+	u, err := url.Parse(source)
+	if err != nil || u.Scheme != "https" || u.Host != "models.dev" || u.Path != "/catalog.json" || u.User != nil || u.RawQuery != "" || u.Fragment != "" {
+		return errors.New("unsupported fallback evidence source")
+	}
+	return nil
+}
