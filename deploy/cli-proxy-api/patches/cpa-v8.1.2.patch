+++ b/internal/pluginhost/provider_dispatch_budget.go
@@ -0,0 +1,22 @@
+package pluginhost
+
+import (
+	"net/http"
+	"strings"
+)
+
+// Provider-scoped exception until the mainline plugin SDK exposes redirect
+// control. A redirect is another physical request, outside the admitted budget.
+// Clone the client value: never mutate shared policy or alter other providers.
+func providerDispatchClient(client *http.Client, provider string) *http.Client {
+	switch strings.ToLower(strings.TrimSpace(provider)) {
+	case "opencode", "cline", "freehub", "free-model-hub":
+		copy := *client
+		copy.CheckRedirect = func(*http.Request, []*http.Request) error {
+			return http.ErrUseLastResponse
+		}
+		return &copy
+	default:
+		return client
+	}
+}
diff --git a/internal/pluginhost/provider_dispatch_budget_test.go b/internal/pluginhost/provider_dispatch_budget_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..facc11f4949242a573ccf559ca9e836a38b3564e
--- /dev/null
+++ b/internal/pluginhost/provider_dispatch_budget_test.go
@@ -0,0 +1,55 @@
+package pluginhost
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+)
+
+func TestProviderDispatchBudget(t *testing.T) {
+	for _, provider := range []string{"opencode", "cline", "freehub", "free-model-hub", " OPENCODE ", "unrelated"} {
+		t.Run(provider, func(t *testing.T) {
+			var originCalls, targetCalls, policyCalls atomic.Int64
+			target := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				targetCalls.Add(1)
+				w.WriteHeader(200)
+			}))
+			defer target.Close()
+			origin := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				originCalls.Add(1)
+				http.Redirect(w, r, target.URL, http.StatusTemporaryRedirect)
+			}))
+			defer origin.Close()
+			original := &http.Client{CheckRedirect: func(*http.Request, []*http.Request) error {
+				policyCalls.Add(1)
+				return nil
+			}}
+			client := providerDispatchClient(original, provider)
+			response, err := client.Post(origin.URL, "application/json", strings.NewReader(`{"fixture":true}`))
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, _ = io.Copy(io.Discard, response.Body)
+			_ = response.Body.Close()
+			if originCalls.Load() != 1 {
+				t.Fatal("origin called more than once")
+			}
+			if provider == "unrelated" {
+				if client != original || response.StatusCode != 200 || targetCalls.Load() != 1 || policyCalls.Load() != 1 {
+					t.Fatal("unrelated provider policy changed")
+				}
+			} else {
+				if client == original || response.StatusCode != 307 || targetCalls.Load() != 0 || policyCalls.Load() != 0 {
+					t.Fatal("custom provider followed redirect")
+				}
+				// The original object's policy must still be intact.
+				if err := original.CheckRedirect(nil, nil); err != nil || policyCalls.Load() != 1 {
+					t.Fatal("shared client was mutated")
+				}
+			}
+		})
+	}
+}
diff --git a/internal/registry/canonical_registry.go b/internal/registry/canonical_registry.go
new file mode 100644
index 0000000000000000000000000000000000000000..23dc078f0019a0deab7d9fb4dd005a99798ef796
--- /dev/null
+++ b/internal/registry/canonical_registry.go
@@ -0,0 +1,131 @@
+package registry
+
+import (
+	"sort"
+	"sync/atomic"
+)
+
+var canonicalDiscoveryOnly atomic.Bool
+
+func setCanonicalDiscoveryOnly(on bool) {
+	canonicalDiscoveryOnly.Store(on)
+	r := GetGlobalRegistry()
+	r.mutex.Lock()
+	defer r.mutex.Unlock()
+	r.invalidateAvailableModelsCacheLocked()
+}
+
+// canonicalInfoLocked intersects every credential, including different vendors
+// hosted by the same plugin. Canonical entries exclude hidden paid/raw collisions.
+func (r *ModelRegistry) canonicalInfoLocked(id string, reg *ModelRegistration, provider string) *ModelInfo {
+	if reg == nil {
+		return nil
+	}
+	infos := map[string]*ModelInfo{}
+	visible := false
+	canonicalized := false
+	for client, byID := range r.clientModelInfos {
+		if provider != "" && r.clientProviders[client] != provider {
+			continue
+		}
+		if info := byID[id]; info != nil {
+			infos[client] = info
+			if info.CanonicalID != "" {
+				canonicalized = true
+			}
+			if canonicalRouteEntry(info) {
+				visible = true
+			}
+		}
+	}
+	if !canonicalized {
+		if provider != "" {
+			if info := reg.InfoByProvider[provider]; info != nil {
+				return cloneModelInfo(info)
+			}
+		}
+		return commonModelInfo(reg)
+	}
+	if len(infos) == 0 {
+		return commonModelInfo(reg)
+	}
+	synthetic := &ModelRegistration{Info: reg.Info, InfoByProvider: map[string]*ModelInfo{}, Providers: map[string]int{}}
+	for client, info := range infos {
+		if info.CanonicalID == "" {
+			continue
+		}
+		if visible && !canonicalRouteEntry(info) {
+			continue
+		}
+		if len(synthetic.InfoByProvider) == 0 {
+			synthetic.Info = info
+		}
+		synthetic.InfoByProvider[client] = info
+		synthetic.Providers[client] = 1
+	}
+	result := commonModelInfo(synthetic)
+	if result != nil {
+		result.HideFromDiscovery = true
+		for _, info := range synthetic.InfoByProvider {
+			if !info.HideFromDiscovery {
+				result.HideFromDiscovery = false
+				break
+			}
+		}
+	}
+	return result
+}
+func (r *ModelRegistry) hasCanonicalLocked(id string) bool {
+	for _, byID := range r.clientModelInfos {
+		if info := byID[id]; info != nil && canonicalRouteEntry(info) {
+			return true
+		}
+	}
+	return false
+}
+
+// CanonicalRouteSource is per-credential, never a provider/global alias lookup.
+// Exact override requests have no rewrite. Hidden entries remain callable.
+func (r *ModelRegistry) CanonicalRouteSource(client, id string) string {
+	r.mutex.RLock()
+	defer r.mutex.RUnlock()
+	if info := r.clientModelInfos[client][id]; info != nil {
+		return info.CanonicalSourceID
+	}
+	return ""
+}
+
+// CanonicalOverrides exposes route IDs only, never credential indexes or secrets.
+func (r *ModelRegistry) CanonicalOverrides(id string) []string {
+	r.mutex.RLock()
+	defer r.mutex.RUnlock()
+	out := map[string]bool{}
+	for _, byID := range r.clientModelInfos {
+		for name, info := range byID {
+			if info.HideFromDiscovery && info.CanonicalID == id && info.CanonicalOverride {
+				out[name] = true
+			}
+		}
+	}
+	names := make([]string, 0, len(out))
+	for name := range out {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	return names
+}
+
+func canonicalRouteEntry(info *ModelInfo) bool {
+	return info != nil && info.CanonicalID != "" && (!info.HideFromDiscovery || info.CanonicalPolicy == "free" || info.CanonicalPolicy == "paid")
+}
+func (r *ModelRegistry) CanonicalRouteInfos(id string) map[string]*ModelInfo {
+	r.mutex.RLock()
+	defer r.mutex.RUnlock()
+	out := map[string]*ModelInfo{}
+	for client, byID := range r.clientModelInfos {
+		if info := byID[id]; info != nil && info.CanonicalID != "" {
+			out[client] = cloneModelInfo(info)
+		}
+	}
+	return out
+}
