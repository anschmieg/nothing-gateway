+}
+func TestSessionCompactionCannotSwitchModels(t *testing.T) {
+	h, e := profileFixture(t, map[string]int{"cf-kilo": 503, "cf-other": 503})
+	ctx := registry.WithModelProfile(context.Background(), "coding")
