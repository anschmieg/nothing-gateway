--- /dev/null
+++ b/internal/registry/routing_types.go
@@ -0,0 +1,66 @@
+package registry
+
+import (
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/catalogfallback"
+	"sync/atomic"
+)
+
+// CanonicalRoutingConfig bounds deliberate policy failover, not SDK retries.
+type CanonicalRoutingConfig struct {
+	Profiles                  map[string]ModelProfile `yaml:"profiles,omitempty" json:"profiles,omitempty"`
+	NoChargeAllowances        []NoChargeAllowance     `yaml:"no-charge-allowances,omitempty" json:"no-charge-allowances,omitempty"`
+	EvidenceCache             string                  `yaml:"evidence-cache,omitempty" json:"evidence-cache,omitempty"`
+	EvidenceCatalog           string                  `yaml:"evidence-catalog,omitempty" json:"evidence-catalog,omitempty"`
+	EvidenceMaxAgeHours       int                     `yaml:"evidence-max-age-hours,omitempty" json:"evidence-max-age-hours,omitempty"`
+	RequireComparableEvidence bool                    `yaml:"require-comparable-evidence,omitempty" json:"require-comparable-evidence,omitempty"`
+
+	MaxAttempts       int                 `yaml:"max-attempts,omitempty" json:"max-attempts,omitempty"`
+	MaxFallbackModels int                 `yaml:"max-fallback-models,omitempty" json:"max-fallback-models,omitempty"`
+	FreeFallbacks     map[string][]string `yaml:"free-fallbacks,omitempty" json:"free-fallbacks,omitempty"`
+}
+
+func (p CanonicalRoutingConfig) AttemptLimit() int {
+	if p.MaxAttempts < 1 {
+		return 8
+	}
+	if p.MaxAttempts > 12 {
+		return 12
+	}
+	return p.MaxAttempts
+}
+func (p CanonicalRoutingConfig) FallbackLimit() int {
+	if p.MaxFallbackModels < 1 {
+		return 3
+	}
+	if p.MaxFallbackModels > 6 {
+		return 6
+	}
+	return p.MaxFallbackModels
+}
+
+// CanonicalDispatchBinding captures the admitted target. It is never an alias.
+type CanonicalDispatchBinding struct {
+	AuthID, Route, Source, PairSource, Owner, PluginSource, CostTier string
+	Free                                                             bool
+	Capabilities                                                     string
+}
+
+func NewCanonicalDispatchBinding(auth, route string, info *ModelInfo) CanonicalDispatchBinding {
+	source := info.CanonicalSourceID
+	if source == "" {
+		source = info.ID
+	}
+	pair := info.MetadataModelID
+	if pair == "" {
+		pair = source
+	}
+	return CanonicalDispatchBinding{AuthID: auth, Route: route, Source: source, PairSource: pair, Owner: info.OwnedBy, PluginSource: info.PluginSourceModelID, CostTier: info.PluginCostTier, Free: info.CanonicalFree, Capabilities: catalogfallback.CapabilitiesHash(CanonicalFallbackCapabilities(info))}
+}
+
+// One shared permit survives native metadata clones. A hidden retry cannot
+// claim another physical dispatch, even inside a streaming model pool.
+type CanonicalDispatchPermit struct{ claimed atomic.Bool }
+
+func (p *CanonicalDispatchPermit) Claim() bool {
+	return p != nil && p.claimed.CompareAndSwap(false, true)
+}
