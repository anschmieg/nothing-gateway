diff --git a/sdk/api/handlers/canonical_policy.go b/sdk/api/handlers/canonical_policy.go
new file mode 100644
index 0000000000000000000000000000000000000000..c18651bd58e8a9635c41ab04ff8f86beadabc2dd
--- /dev/null
+++ b/sdk/api/handlers/canonical_policy.go
@@ -0,0 +1,370 @@
+package handlers
+
+import (
+	"encoding/json"
+	"errors"
+	"net/http"
+	"strings"
+
+	"github.com/MoeForge/moego/ojson"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/interfaces"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/thinking"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	log "github.com/sirupsen/logrus"
+	"golang.org/x/net/context"
+	"time"
+)
+
+type canonicalAttemptContextKey struct{}
+type canonicalAttemptContext struct {
+	Excluded []string
+	Route    string
+	Bindings map[string]registry.CanonicalDispatchBinding
+	Permit   *registry.CanonicalDispatchPermit
+}
+type canonicalStage struct {
+	Model           string
+	Tier            int
+	Billing         registry.BillingPolicy
+	Alternative     bool
+	Allowed         map[string]bool
+	PlannedBindings map[string]registry.CanonicalDispatchBinding
+	Evidence        *canonicalComparison
+}
+type canonicalPlan struct {
+	Requested, Base, Policy, Suffix string
+	Profile                         string
+	Billing                         registry.BillingPolicy
+	Stages                          []canonicalStage
+	Limit                           int
+	Requirements                    canonicalRequirements
+}
+
+func canonicalInput(model string) (base, suffix string, freeOnly, ok bool) {
+	parsed := thinking.ParseSuffix(model)
+	name := parsed.ModelName
+	suffix = strings.TrimPrefix(model, name)
+	if strings.HasSuffix(name, ":free") {
+		freeOnly = true
+		name = strings.TrimSuffix(name, ":free")
+	}
+	info := registry.GetGlobalRegistry().GetModelInfo(name, "")
+	if info == nil || info.CanonicalID != name || info.CanonicalPolicy != "canonical" {
+		return "", "", false, false
+	}
+	return name, suffix, freeOnly, true
+}
+func containsCanonical(values []string, value string) bool {
+	for _, v := range values {
+		if strings.EqualFold(v, value) {
+			return true
+		}
+	}
+	return false
+}
+func canonicalPair(auth string, info *registry.ModelInfo) string {
+	source := info.MetadataModelID
+	if source == "" {
+		source = info.CanonicalSourceID
+	}
+	if source == "" {
+		source = info.ID
+	}
+	return auth + "\x00" + source
+}
+func canonicalExclusions(stage canonicalStage, r canonicalRequirements, tried map[string]bool, quota map[string]bool) []string {
+	excluded := []string{}
+	for auth, info := range registry.GetGlobalRegistry().CanonicalRouteInfos(stage.Model) {
+		skip := (stage.Allowed != nil && !stage.Allowed[auth]) || (stage.PlannedBindings != nil && stage.PlannedBindings[auth] != registry.NewCanonicalDispatchBinding(auth, stage.Model, info)) || tried[canonicalPair(auth, info)] || (strings.HasSuffix(stage.Model, ":free") && quota[auth])
+		// All free providers share native selection. Only paid OpenRouter has
+		// an explicit provider-specific last-resort tier.
+		if stage.Tier == 2 && strings.EqualFold(info.OwnedBy, "openrouter") || stage.Tier == 3 && !strings.EqualFold(info.OwnedBy, "openrouter") {
+			skip = true
+		}
+		if stage.Alternative && !canonicalBillingCompatible(info, r) {
+			skip = true
+		}
+		if skip {
+			excluded = append(excluded, auth)
+		}
+	}
+	return excluded
+}
+func canonicalCanContinue(err *interfaces.ErrorMessage, selected string) bool {
+	if err == nil {
+		return false
+	}
+	if selected == "" {
+		return err.StatusCode >= 500 || err.StatusCode == 404 || err.StatusCode == 429
+	}
+	return err.StatusCode == 429 || err.StatusCode == 503 || err.StatusCode == 404
+}
+func canonicalBody(raw []byte, model string) []byte {
+	var v map[string]json.RawMessage
+	if json.Unmarshal(raw, &v) != nil {
+		return raw
+	}
+	if _, ok := v["model"]; !ok {
+		return raw
+	}
+	updated, err := ojson.SetBytes(raw, "model", model)
+	if err != nil {
+		return raw
+	}
+	return updated
+}
+func canonicalHeaders(headers http.Header, p canonicalPlan, stage canonicalStage, selected string, count int, bindings map[string]registry.CanonicalDispatchBinding, ctx context.Context) http.Header {
+	if headers == nil {
+		headers = http.Header{}
+	}
+	resolved := strings.TrimSuffix(strings.TrimSuffix(stage.Model, ":free"), ":paid")
+	headers.Set("X-Gateway-Requested-Model", p.Requested)
+	headers.Set("X-Gateway-Resolved-Model", resolved)
+	headers.Set("X-Gateway-Cost-Policy", p.Policy)
+	headers.Set("X-Gateway-Billing-Class", string(stage.Billing))
+	headers.Set("X-Gateway-Billing-Policy", string(p.Billing))
+	canonicalSelectionHeaders(headers, p, stage)
+	if p.Profile != "" {
+		headers.Set("X-Gateway-Profile", p.Profile)
+		headers.Set("X-Gateway-Model-Mode", "hint")
+		headers.Set("X-Gateway-Similarity-Anchor", p.Base)
+	}
+	if b, ok := bindings[selected]; ok {
+		headers.Set("X-Gateway-Provider", b.Owner)
+	}
+	log.WithFields(log.Fields{"requested_model": p.Requested, "resolved_model": resolved, "provider": headers.Get("X-Gateway-Provider"), "cost_policy": p.Policy, "attempts": count}).Info("canonical request resolved")
+	return billingResponseHeaders(headers, ctx, p)
+}
+func canonicalAttemptContextFor(ctx context.Context, stage canonicalStage, r canonicalRequirements, tried, quota map[string]bool, selected *string, managers ...*coreauth.Manager) (context.Context, map[string]registry.CanonicalDispatchBinding) {
+	previous := selectedAuthIDCallbackFromContext(ctx)
+	excluded := canonicalExclusions(stage, r, tried, quota)
+	blocked := map[string]bool{}
+	for _, id := range excluded {
+		blocked[id] = true
+	}
+	bindings := map[string]registry.CanonicalDispatchBinding{}
+	for id, info := range registry.GetGlobalRegistry().CanonicalRouteInfos(stage.Model) {
+		if len(managers) > 0 && managers[0] != nil {
+			m := managers[0]
+			a, ok := m.GetByID(id)
+			if !ok || m.CanonicalBillingClass(a, info, time.Now()) != stage.Billing || !m.CanonicalBillingAvailable(id, stage.Model, time.Now(), registry.DispatchBilling(ctx)) {
+				blocked[id] = true
+				excluded = append(excluded, id)
+			}
+		}
+		if !blocked[id] {
+			bindings[id] = registry.NewCanonicalDispatchBinding(id, stage.Model, info)
+		}
+	}
+	if len(bindings) > 0 {
+		if trace := registry.RoutingTraceFromContext(ctx); trace != nil {
+			trace.AwaitRoute()
+		}
+	}
+	ctx = context.WithValue(ctx, canonicalAttemptContextKey{}, canonicalAttemptContext{Excluded: excluded, Route: stage.Model, Bindings: bindings, Permit: &registry.CanonicalDispatchPermit{}})
+	return WithSelectedAuthIDCallback(ctx, func(id string) {
+		*selected = id
+		if previous != nil {
+			previous(id)
+		}
+	}), bindings
+}
+func canonicalRecordAttempt(stage canonicalStage, selected string, bindings map[string]registry.CanonicalDispatchBinding, tried map[string]bool) {
+	if b, ok := bindings[selected]; ok {
+		tried[selected+"\x00"+b.PairSource] = true
+	}
+}
+func (h *BaseAPIHandler) executeWithAuthManagerFormats(ctx context.Context, entry, exit, model string, raw []byte, alt string, image bool, opts modelExecutionOptions) ([]byte, http.Header, *interfaces.ErrorMessage) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if alt == "responses/compact" {
+		ctx = registry.WithBoundModel(ctx)
+	}
+	if pluginCtx, handled, invalid := h.admitResponsesPluginRoute(ctx, entry, exit, model, raw, alt, opts); handled {
+		if invalid != nil {
+			return nil, nil, invalid
+		}
+		body, headers, err := h.executeWithPluginExecutor(pluginCtx, entry, exit, model, model, raw, alt, registry.ResponsesPluginID, opts)
+		if err == nil {
+			headers = billingResponseHeaders(headers, ctx, canonicalPlan{Billing: registry.BillingPaid})
+		}
+		return body, headers, err
+	}
+	p, handled, invalid := h.canonicalPlan(ctx, model, raw, opts, !image && canonicalChatProtocol(entry))
+	if invalid != nil {
+		return nil, nil, invalid
+	}
+	if !handled {
+		return h.executeCanonicalNonstreamAttempt(ctx, entry, exit, model, raw, alt, image, opts)
+	}
+	tried := map[string]bool{}
+	quota := map[string]bool{}
+	count := 0
+	var last *interfaces.ErrorMessage
+	for _, stage := range p.Stages {
+		for count < p.Limit {
+			selected := ""
+			attemptCtx, bindings := canonicalAttemptContextFor(registry.WithUncertainFeatureCost(registry.WithDispatchBilling(ctx, p.Billing), p.Requirements.UnverifiedCostFeatures), stage, p.Requirements, tried, quota, &selected, h.AuthManager)
+			if len(bindings) == 0 {
+				break
+			}
+			body, headers, err := h.executeCanonicalNonstreamAttempt(attemptCtx, entry, exit, stage.Model+p.Suffix, canonicalBody(raw, stage.Model+p.Suffix), alt, image, opts)
+			if selected != "" {
+				count++
+				canonicalRecordAttempt(stage, selected, bindings, tried)
+			}
+			if err == nil {
+				return body, canonicalHeaders(headers, p, stage, selected, count, bindings, ctx), nil
+			}
+			if selected != "" || last == nil {
+				last = err
+			}
+			if ctx.Err() != nil {
+				return nil, headers, err
+			}
+			if !canonicalCanContinue(err, selected) {
+				return nil, headers, err
+			}
+			if err.StatusCode == 429 && selected != "" {
+				quota[selected] = true
+			}
+			if selected == "" {
+				break
+			}
+		}
+		if count >= p.Limit {
+			break
+		}
+	}
+	if last == nil {
+		last = &interfaces.ErrorMessage{StatusCode: 503, Error: errors.New("no compatible eligible canonical route")}
+	}
+	return nil, nil, last
+}
+func (h *BaseAPIHandler) executeStreamWithAuthManagerFormats(ctx context.Context, entry, exit, model string, raw []byte, alt string, image bool, opts modelExecutionOptions) (<-chan []byte, http.Header, <-chan *interfaces.ErrorMessage) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if alt == "responses/compact" {
+		ctx = registry.WithBoundModel(ctx)
+	}
+	if pluginCtx, handled, invalid := h.admitResponsesPluginRoute(ctx, entry, exit, model, raw, alt, opts); handled {
+		if invalid != nil {
+			ch := make(chan *interfaces.ErrorMessage, 1)
+			ch <- invalid
+			close(ch)
+			return nil, nil, ch
+		}
+		data, headers, errs := h.streamWithPluginExecutor(pluginCtx, entry, exit, model, model, raw, alt, registry.ResponsesPluginID, opts)
+		if data != nil {
+			headers = billingResponseHeaders(headers, ctx, canonicalPlan{Billing: registry.BillingPaid})
+		}
+		return data, headers, errs
+	}
+	p, handled, invalid := h.canonicalPlan(ctx, model, raw, opts, !image && canonicalChatProtocol(entry))
+	if !handled && invalid == nil {
+		return h.executeCanonicalStreamAttempt(ctx, entry, exit, model, raw, alt, image, opts)
+	}
+	fail := func(e *interfaces.ErrorMessage) (<-chan []byte, http.Header, <-chan *interfaces.ErrorMessage) {
+		ch := make(chan *interfaces.ErrorMessage, 1)
+		ch <- e
+		close(ch)
+		return nil, nil, ch
+	}
+	if invalid != nil {
+		return fail(invalid)
+	}
+	tried := map[string]bool{}
+	quota := map[string]bool{}
+	count := 0
+	var last *interfaces.ErrorMessage
+	for _, stage := range p.Stages {
+		for count < p.Limit {
+			selected := ""
+			attemptCtx, cancel := context.WithCancel(ctx)
+			attemptCtx, bindings := canonicalAttemptContextFor(registry.WithUncertainFeatureCost(registry.WithDispatchBilling(attemptCtx, p.Billing), p.Requirements.UnverifiedCostFeatures), stage, p.Requirements, tried, quota, &selected, h.AuthManager)
+			if len(bindings) == 0 {
+				cancel()
+				break
+			}
+			data, headers, errs := h.executeCanonicalStreamAttempt(attemptCtx, entry, exit, stage.Model+p.Suffix, canonicalBody(raw, stage.Model+p.Suffix), alt, image, opts)
+			if selected != "" {
+				count++
+				canonicalRecordAttempt(stage, selected, bindings, tried)
+			}
+			var first []byte
+			var open bool
+			if data != nil {
+				select {
+				case first, open = <-data:
+				case <-ctx.Done():
+					cancel()
+					return fail(&interfaces.ErrorMessage{StatusCode: 499, Error: ctx.Err()})
+				}
+			}
+			if open {
+				out := make(chan []byte)
+				headers = canonicalHeaders(headers, p, stage, selected, count, bindings, ctx)
+				go func() {
+					defer close(out)
+					defer cancel()
+					select {
+					case out <- first:
+					case <-ctx.Done():
+						return
+					}
+					for chunk := range data {
+						select {
+						case out <- chunk:
+						case <-ctx.Done():
+							return
+						}
+					}
+				}()
+				return out, headers, errs // Once a byte is committed, no model/provider fallback.
+			}
+			var err *interfaces.ErrorMessage
+			if errs != nil {
+				select {
+				case err = <-errs:
+				case <-ctx.Done():
+					cancel()
+					return fail(&interfaces.ErrorMessage{StatusCode: 499, Error: ctx.Err()})
+				}
+			}
+			cancel()
+			if err == nil {
+				err = &interfaces.ErrorMessage{StatusCode: 502, Error: errors.New("upstream stream ended without output")}
+			}
+			if selected != "" || last == nil {
+				last = err
+			}
+			if ctx.Err() != nil || !canonicalCanContinue(err, selected) {
+				return fail(err)
+			}
+			if err.StatusCode == 429 && selected != "" {
+				quota[selected] = true
+			}
+			if selected == "" {
+				break
+			}
+		}
+		if count >= p.Limit {
+			break
+		}
+	}
+	if last == nil {
+		last = &interfaces.ErrorMessage{StatusCode: 503, Error: errors.New("no compatible eligible canonical route")}
+	}
+	return fail(last)
+}
+
+func canonicalChatProtocol(entry string) bool {
+	switch entry {
+	case "openai", "claude", "openai-response", "gemini":
+		return true
+	}
+	return false
+}
