+package auth
+
+import (
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	"testing"
+	"time"
+)
+
+func TestCanonicalReverseMappingIsCredentialScopedAndKeepsOverrides(t *testing.T) {
+	r := registry.GetGlobalRegistry()
+	a := &Auth{ID: "canonical-auth-a", Prefix: "orca"}
+	b := &Auth{ID: "canonical-auth-b"}
+	defer r.UnregisterClient(a.ID)
+	defer r.UnregisterClient(b.ID)
+	r.RegisterClient(a.ID, "orca", []*registry.ModelInfo{{ID: "glm-5.3-flash", CanonicalID: "glm-5.3-flash", CanonicalSourceID: "orca/z-ai/glm-5.3-flash-free"}, {ID: "orca/z-ai/glm-5.3-flash-free", HideFromDiscovery: true}})
+	r.RegisterClient(b.ID, "freehub", []*registry.ModelInfo{{ID: "glm-5.3-flash", CanonicalID: "glm-5.3-flash", CanonicalSourceID: "llm7-llm7/GLM-5.3-Flash"}, {ID: "llm7/GLM-5.3-Flash", HideFromDiscovery: true, CanonicalSourceID: "llm7-llm7/GLM-5.3-Flash"}})
+	if got := rewriteModelForAuth("glm-5.3-flash", a); got != "z-ai/glm-5.3-flash-free" {
+		t.Fatal(got)
+	}
+	if got := rewriteModelForAuth("glm-5.3-flash", b); got != "llm7-llm7/GLM-5.3-Flash" {
+		t.Fatal(got)
+	}
+	if got := rewriteModelForAuth("llm7/GLM-5.3-Flash", b); got != "llm7-llm7/GLM-5.3-Flash" {
+		t.Fatal(got)
+	}
+	if got := rewriteModelForAuth("orca/z-ai/glm-5.3-flash-free", a); got != "z-ai/glm-5.3-flash-free" {
+		t.Fatal("legacy override lost", got)
+	}
+}
+
+func TestCanonicalSelectorUsesExistingSourceCooldown(t *testing.T) {
+	r := registry.GetGlobalRegistry()
+	a := &Auth{ID: "canonical-held-source", Prefix: "orca", Provider: "openai-compatible-orcarouter", ModelStates: map[string]*ModelState{"z-ai/glm-5.3-flash": {Unavailable: true, NextRetryAfter: time.Now().Add(time.Hour)}}}
+	defer r.UnregisterClient(a.ID)
+	r.RegisterClient(a.ID, a.Provider, []*registry.ModelInfo{{ID: "glm-5.3-flash:paid", HideFromDiscovery: true, CanonicalID: "glm-5.3-flash", CanonicalPolicy: "paid", CanonicalSourceID: "z-ai/glm-5.3-flash"}})
+	m := NewManager(nil, nil, nil)
+	source := m.selectionModelForAuth(a, "glm-5.3-flash:paid")
+	if source != "z-ai/glm-5.3-flash" {
+		t.Fatal(source)
+	}
+	if blocked, _, _ := isAuthBlockedForModel(a, source, time.Now()); !blocked {
+		t.Fatal("new selector bypassed existing upstream cooldown")
+	}
+}
diff --git a/sdk/cliproxy/auth/canonical_policy_execution.go b/sdk/cliproxy/auth/canonical_policy_execution.go
new file mode 100644
index 0000000000000000000000000000000000000000..780340aac9653b51ca345e7041dc0715e365da57
--- /dev/null
+++ b/sdk/cliproxy/auth/canonical_policy_execution.go
@@ -0,0 +1,137 @@
+package auth
+
+import (
+	"context"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/thinking"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"strings"
+)
+
+func canonicalOneDispatch(meta map[string]any) bool {
+	v, _ := meta["gateway.canonical_dispatch"].(bool)
+	return v
+}
+func canonicalAttemptExclusions(meta map[string]any) []string {
+	v, _ := meta["gateway.canonical_excluded_auths"].([]string)
+	return v
+}
+func (m *Manager) CanonicalRoutingPolicy() registry.CanonicalRoutingConfig {
+	cfg := m.runtimeConfigSnapshot()
+	if cfg == nil {
+		return registry.CanonicalRoutingConfig{}
+	}
+	p := cfg.Models.CanonicalRouting
+	if p.Profiles != nil {
+		cloned := map[string]registry.ModelProfile{}
+		for name, profile := range p.Profiles {
+			cloned[name] = profile
+		}
+		p.Profiles = cloned
+	}
+	p.NoChargeAllowances = append([]registry.NoChargeAllowance(nil), p.NoChargeAllowances...)
+	for i := range p.NoChargeAllowances {
+		p.NoChargeAllowances[i].SourceModels = append([]string(nil), p.NoChargeAllowances[i].SourceModels...)
+	}
+	if p.FreeFallbacks != nil {
+		out := map[string][]string{}
+		for k, v := range p.FreeFallbacks {
+			out[k] = append([]string{}, v...)
+		}
+		p.FreeFallbacks = out
+	}
+	return p
+}
+
+// Once registered as canonical, a target is final: no second alias or pool pass.
+func canonicalPinnedModel(a *Auth, route string) (string, bool) {
+	if a == nil {
+		return "", false
+	}
+	base := thinking.ParseSuffix(route).ModelName
+	info := registry.GetGlobalRegistry().CanonicalRouteInfos(base)[a.ID]
+	if info == nil || info.CanonicalSourceID == "" {
+		return "", false
+	}
+	return preserveRequestedModelSuffix(route, info.CanonicalSourceID), true
+}
+func (m *Manager) validateCanonicalDispatch(ctx context.Context, a *Auth, req cliproxyexecutor.Request, opts *cliproxyexecutor.Options) error {
+	if !canonicalOneDispatch(opts.Metadata) {
+		return nil
+	}
+	refused := func() error {
+		return &Error{Code: "canonical_admission_changed", Message: "canonical target admission changed; request was not dispatched", HTTPStatus: 409}
+	}
+	route, _ := opts.Metadata["gateway.canonical_route"].(string)
+	bindings, ok := opts.Metadata["gateway.canonical_bindings"].(map[string]registry.CanonicalDispatchBinding)
+	if !ok || a == nil {
+		return refused()
+	}
+	bound, ok := bindings[a.ID]
+	if !ok || bound.AuthID != a.ID || bound.Route != route {
+		return refused()
+	}
+	current := registry.GetGlobalRegistry().CanonicalRouteInfos(route)[a.ID]
+	if current == nil || registry.NewCanonicalDispatchBinding(a.ID, route, current) != bound {
+		return refused()
+	}
+	if strings.HasSuffix(route, ":free") && !bound.Free {
+		return refused()
+	}
+	if thinking.ParseSuffix(req.Model).ModelName != bound.Source {
+		return refused()
+	}
+	permit, _ := opts.Metadata["gateway.canonical_permit"].(*registry.CanonicalDispatchPermit)
+	if !permit.Claim() {
+		return &Error{Code: "canonical_dispatch_budget", Message: "canonical physical dispatch permit already consumed", HTTPStatus: 409}
+	}
+	if err := m.guardBillingDispatch(ctx, a, current, strings.TrimSuffix(strings.TrimSuffix(route, ":free"), ":paid")); err != nil {
+		return err
+	}
+	opts.Metadata["gateway.canonical_source_model"] = bound.PluginSource
+	opts.Metadata["gateway.canonical_cost_tier"] = bound.CostTier
+	opts.Metadata["gateway.canonical_vendor"] = bound.Owner
+	opts.Metadata["gateway.canonical_free"] = bound.Free
+	return nil
+}
+func (m *Manager) executeCanonicalGuarded(ctx context.Context, e ProviderExecutor, a *Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	if err := m.validateCanonicalDispatch(ctx, a, req, &opts); err != nil {
+		return cliproxyexecutor.Response{}, err
+	}
+	release, err := m.acquireGeminiRecovery(a, req.Model)
+	if err != nil {
+		return cliproxyexecutor.Response{}, err
+	}
+	if release != nil {
+		defer release()
+	}
+	return e.Execute(ctx, a, req, opts)
+}
+func (m *Manager) streamCanonicalGuarded(ctx context.Context, e ProviderExecutor, a *Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	if err := m.validateCanonicalDispatch(ctx, a, req, &opts); err != nil {
+		return nil, err
+	}
+	release, err := m.acquireGeminiRecovery(a, req.Model)
+	if err != nil {
+		return nil, err
+	}
+	result, err := e.ExecuteStream(ctx, a, req, opts)
+	if err != nil {
+		if release != nil {
+			release()
+		}
+		return nil, err
+	}
+	return holdGeminiRecoveryStream(ctx, result, release), nil
+}
+func (m *Manager) countCanonicalGuarded(ctx context.Context, e ProviderExecutor, a *Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	if err := m.validateCanonicalDispatch(ctx, a, req, &opts); err != nil {
+		return cliproxyexecutor.Response{}, err
+	}
+	return e.CountTokens(ctx, a, req, opts)
+}
+
+func (m *Manager) CanonicalRoutingEnabled() bool {
+	cfg := m.runtimeConfigSnapshot()
+	return cfg != nil && cfg.Models.CanonicalOnly
+}
