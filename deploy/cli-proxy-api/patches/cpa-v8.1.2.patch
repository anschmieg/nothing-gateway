+	s := &Service{}
+	for _, tc := range []struct{ body, want string }{
+		{`{"data":[{"id":"z-ai/glm-5.3-flash-free","pricing":{"request":"0"}}]}`, "glm-5.3-flash"},
+		{`{"data":[{"id":"z-ai/glm-5.3-flash-free","pricing":{"request":"1"}}]}`, "glm-5.3-flash"},
+		{`{"data":[]}`, ""},
+		{`{"data":[{"id":"z-ai/glm-5.3-flash-free","pricing":{"request":"0"}}]}`, "glm-5.3-flash"},
