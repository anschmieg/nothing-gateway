+	h, e = profileFixture(t, map[string]int{"cf-kilo": 503, "cf-other": 503})
+	_, _, err = h.ExecuteWithAuthManager(billingContext(t, registry.BillingPaid, ""), "openai", "glm-5.3-flash:free", []byte(billingRaw), "")
+	if err == nil || len(e.calls) != 2 {
