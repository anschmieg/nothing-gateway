+	_, _, err := h.ExecuteWithAuthManager(context.Background(), "openai", "glm-5.3-flash:free", []byte(`{"messages":[{"role":"assistant","tool_calls":[{"function":{"name":"x","extra_content":{"google":{"thought_signature":"fixture"}}}}]}]}`), "")
