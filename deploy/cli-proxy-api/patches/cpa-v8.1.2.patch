+)
+
+func fixtureMetadataArchive(t *testing.T, evil bool) []byte {
+	t.Helper()
+	var out bytes.Buffer
+	gz := gzip.NewWriter(&out)
+	tw := tar.NewWriter(gz)
+	if err := tw.WriteHeader(&tar.Header{Name: "pax_global_header", Typeflag: tar.TypeXGlobalHeader, Format: tar.FormatPAX, PAXRecords: map[string]string{"comment": "metadata-only header"}}); err != nil {
+		t.Fatal(err)
+	}
+	add := func(name, body string) {
+		if err := tw.WriteHeader(&tar.Header{Name: "repo/" + name, Mode: 0600, Size: int64(len(body))}); err != nil {
+			t.Fatal(err)
+		}
+		_, _ = tw.Write([]byte(body))
+	}
+	add("models/lab/a.toml", "schema = 2\nfamily = 'fixture'\ntype = 'chat'\n")
+	add("providers/fixture/models/source.toml", "schema = 2\nbase_model = 'lab/a'\n")
+	target := "source.toml"
+	if evil {
+		target = "../../../../outside.toml"
+	}
+	_ = tw.WriteHeader(&tar.Header{Name: "repo/providers/fixture/models/alias.toml", Typeflag: tar.TypeSymlink, Linkname: target})
+	_ = tw.Close()
+	_ = gz.Close()
+	return out.Bytes()
+}
+func TestDraftNativeLiveGitDataConversionAndConditionalCache(t *testing.T) {
+	raw := fixtureMetadataArchive(t, false)
+	commit := strings.Repeat("a", 40)
+	calls := 0
+	c := NewLiveCache(&http.Client{Transport: fixtureRoundTripper(func(r *http.Request) (*http.Response, error) {
+		calls++
+		status := 200
+		body := raw
+		headers := http.Header{}
+		switch r.URL.String() {
+		case GitCatalogURL:
+			if calls == 1 {
+				body = []byte(`{"sha":"` + commit + `"}`)
+				headers.Set("ETag", `"head-v1"`)
+			} else {
+				if r.Header.Get("If-None-Match") != `"head-v1"` {
+					t.Fatal("lost commit validator")
+				}
+				status = 304
+				body = nil
+			}
+		case "https://codeload.github.com/anomalyco/models.dev/tar.gz/" + commit:
+		default:
+			t.Fatal("unapproved metadata request", r.URL)
+		}
+		return &http.Response{StatusCode: status, Header: headers, Body: io.NopCloser(bytes.NewReader(body))}, nil
+	})})
+	data, fresh, err := c.Refresh(context.Background(), GitCatalogURL, "", fixtureNow)
+	if err != nil || !fresh {
+		t.Fatal(fresh, err)
+	}
+	s, err := DecodeModelsDev(data, fixtureNow)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if id, ok := s.Resolve("fixture", "alias"); !ok || id != "lab/a" {
+		t.Fatal(id, ok)
+	}
+	_, fresh, err = c.Refresh(context.Background(), GitCatalogURL, "", fixtureNow)
+	if err != nil || !fresh || calls != 3 {
+		t.Fatal("304 redownloaded archive", calls, fresh, err)
+	}
+}
+func TestDraftNativeGitArchiveAliasesAndProvenance(t *testing.T) {
+	commit := strings.Repeat("b", 40)
+	data, err := ConvertModelsDevArchive(fixtureMetadataArchive(t, false), commit, fixtureNow)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var root map[string]any
+	_ = json.Unmarshal(data, &root)
+	evidence := root["_evidence"].(map[string]any)
+	if evidence["source_commit"] != commit || evidence["archive_sha256"] == "" {
+		t.Fatal(evidence)
+	}
+	if _, err = ConvertModelsDevArchive(fixtureMetadataArchive(t, true), commit, fixtureNow); err == nil {
+		t.Fatal("escaping symlink accepted")
+	}
+	if _, err = ConvertModelsDevArchive([]byte("garbage"), commit, fixtureNow); err == nil {
+		t.Fatal("corrupt archive accepted")
+	}
+	if _, err = ConvertModelsDevArchive(fixtureMetadataArchive(t, false), "not-a-sha", fixtureNow); err == nil {
+		t.Fatal("unversioned archive accepted")
+	}
+}
diff --git a/internal/catalogfallback/live_cache.go b/internal/catalogfallback/live_cache.go
new file mode 100644
index 0000000000000000000000000000000000000000..e94fcbaf5c93bc69d821020c475a04189246deae
--- /dev/null
+++ b/internal/catalogfallback/live_cache.go
@@ -0,0 +1,205 @@
+package catalogfallback
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+)
+
+const LiveCatalogURL = "https://models.dev/catalog.json"
+
+type cachedEvidence struct {
+	Source       string          `json:"source"`
+	ETag         string          `json:"etag,omitempty"`
+	LastModified string          `json:"last_modified,omitempty"`
+	ValidatedAt  time.Time       `json:"validated_at"`
+	Data         json.RawMessage `json:"data"`
+}
+
+// LiveCache is used by the host's background updater, never by an inference.
+// Failed HTTP/validation retains the previous data AND its validation timestamp.
+// Fresh means an origin 200 or conditional 304, not a local cache read.
+type LiveCache struct {
+	mu      sync.Mutex
+	entries map[string]cachedEvidence
+	client  *http.Client
+}
+
+func NewLiveCache(client *http.Client) *LiveCache {
+	if client == nil {
+		client = &http.Client{Timeout: 15 * time.Second}
+	}
+	copyClient := *client
+	copyClient.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+	return &LiveCache{client: &copyClient, entries: map[string]cachedEvidence{}}
+}
+func cacheKey(source, path string) string { return source + "\x00" + path }
+func stampEvidence(raw []byte, at time.Time) ([]byte, error) {
+	if _, err := DecodeModelsDev(raw, at); err != nil {
+		return nil, err
+	}
+	var root map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &root); err != nil {
+		return nil, err
+	}
+	var evidence map[string]any
+	if b := root["_evidence"]; len(b) > 0 {
+		if err := json.Unmarshal(b, &evidence); err != nil {
+			return nil, err
+		}
+	}
+	if evidence == nil {
+		evidence = map[string]any{}
+	}
+	evidence["retrieved_at"] = at.UTC().Format(time.RFC3339Nano)
+	root["_evidence"], _ = json.Marshal(evidence)
+	return json.Marshal(root)
+}
+func (c *LiveCache) load(source, path string, now time.Time) (cachedEvidence, bool) {
+	key := cacheKey(source, path)
+	if e, ok := c.entries[key]; ok {
+		return e, true
+	}
+	if path == "" {
+		return cachedEvidence{}, false
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return cachedEvidence{}, false
+	}
+	defer f.Close()
+	raw, err := io.ReadAll(io.LimitReader(f, MaxCatalogBytes+(1<<20)+1))
+	if err != nil || len(raw) > MaxCatalogBytes+(1<<20) {
+		return cachedEvidence{}, false
+	}
+	if validateJSONKeys(raw) != nil {
+		return cachedEvidence{}, false
+	}
+	var e cachedEvidence
+	if json.Unmarshal(raw, &e) != nil || e.Source != source || e.ValidatedAt.IsZero() || e.ValidatedAt.After(now) || len(e.ETag) > 4096 || len(e.LastModified) > 4096 {
+		return cachedEvidence{}, false
+	}
+	s, err := DecodeModelsDev(e.Data, now)
+	if err != nil || !s.publishedAt.Equal(e.ValidatedAt) {
+		return cachedEvidence{}, false
+	}
+	c.entries[key] = e
+	return e, true
+}
+func (c *LiveCache) Cached(source, path string, now time.Time) ([]byte, bool) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	e, ok := c.load(source, path, now)
+	if !ok {
+		return nil, false
+	}
+	return append([]byte(nil), e.Data...), true
+}
+func persistEvidence(path string, e cachedEvidence) error {
+	if path == "" {
+		return nil
+	}
+	if !filepath.IsAbs(path) {
+		return errors.New("evidence cache path must be absolute")
+	}
+	raw, err := json.Marshal(e)
+	if err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(filepath.Dir(path), ".fallback-evidence-*")
+	if err != nil {
+		return err
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	if _, err = f.Write(raw); err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return err
+	}
+	return os.Rename(name, path)
+}
+func (c *LiveCache) Refresh(ctx context.Context, source, path string, now time.Time) (data []byte, fresh bool, err error) {
+	if (source != LiveCatalogURL && source != GitCatalogURL) || (path != "" && !filepath.IsAbs(path)) {
+		return nil, false, errors.New("unsupported live evidence source/cache")
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	old, have := c.load(source, path, now)
+	fallback := func() ([]byte, bool, error) {
+		if have {
+			return append([]byte(nil), old.Data...), false, nil
+		}
+		return nil, false, errors.New("live evidence unavailable; no valid cache")
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, source, nil)
+	if err != nil {
+		return fallback()
+	}
+	if have {
+		req.Header.Set("If-None-Match", old.ETag)
+		req.Header.Set("If-Modified-Since", old.LastModified)
+	}
+	res, err := c.client.Do(req)
+	if err != nil {
+		return fallback()
+	}
+	defer res.Body.Close()
+	next := cachedEvidence{Source: source, ValidatedAt: now, ETag: res.Header.Get("ETag"), LastModified: res.Header.Get("Last-Modified")}
+	if len(next.ETag) > 4096 || len(next.LastModified) > 4096 {
+		return fallback()
+	}
+	switch res.StatusCode {
+	case http.StatusNotModified:
+		if !have || (old.ETag == "" && old.LastModified == "") {
+			return fallback()
+		}
+		// A conflicting 304 validator is not a validation of our stored body.
+		if next.ETag != "" && old.ETag != "" && next.ETag != old.ETag {
+			return fallback()
+		}
+		if next.ETag == "" {
+			next.ETag = old.ETag
+		}
+		if next.LastModified == "" {
+			next.LastModified = old.LastModified
+		}
+		next.Data, err = stampEvidence(old.Data, now)
+	case http.StatusOK:
+		var raw []byte
+		raw, err = io.ReadAll(io.LimitReader(res.Body, MaxCatalogBytes+1))
+		if err != nil || len(raw) > MaxCatalogBytes {
+			return fallback()
+		}
+		if source == GitCatalogURL {
+			raw, err = c.githubCatalog(ctx, raw, now)
+			if err != nil {
+				return fallback()
+			}
+		}
+		next.Data, err = stampEvidence(raw, now)
+	default:
+		return fallback()
+	}
+	if err != nil {
+		return fallback()
+	}
+	// Keep valid fresh memory even when disk is unwritable. Report persistence
+	// failure separately; it must not erase last-good memory or pretend durable.
+	c.entries[cacheKey(source, path)] = next
+	if err = persistEvidence(path, next); err != nil {
+		return append([]byte(nil), next.Data...), true, errors.New("live evidence refreshed but cache persistence failed")
+	}
+	return append([]byte(nil), next.Data...), true, nil
+}
