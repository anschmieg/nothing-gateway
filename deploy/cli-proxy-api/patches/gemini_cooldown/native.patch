 // SupportsApplyPatch reports the actual executor contract, independent of its provider name.
 func (e *GeminiExecutor) SupportsApplyPatch() bool { return e != nil }
+
+// Preserve the upstream status and body while attaching scheduling metadata.
+func newGeminiStatusError(status int, headers http.Header, body []byte) statusErr {
+	e := statusErr{code: status, msg: string(body)}
+	if status != 402 && status != 429 && status != 503 {
+		return e
+	}
+	e.retryAfter = parseRetryAfterHeader(headers, time.Now())
+	if e.retryAfter == nil {
+		for _, detail := range gjson.GetBytes(body, "error.details").Array() {
+			if detail.Get("@type").String() == "type.googleapis.com/google.rpc.RetryInfo" {
+				if d, err := time.ParseDuration(detail.Get("retryDelay").String()); err == nil && d >= 0 {
+					e.retryAfter = &d
+					break
+				}
+			}
+		}
+	}
+	message := strings.ToLower(gjson.GetBytes(body, "error.message").String())
+	// RESOURCE_EXHAUSTED alone also describes model-specific rate limits.
+	e.credentialScoped = (status == 402 || status == 429) &&
+		gjson.GetBytes(body, "error.status").String() == "RESOURCE_EXHAUSTED" &&
+		strings.Contains(message, "prepayment credits") && strings.Contains(message, "depleted")
+	if e.credentialScoped && e.retryAfter == nil {
+		d := 30 * time.Minute
+		e.retryAfter = &d
+	}
+	return e
+}
